<?xml version="1.0"?>
<package format="3">
  <name>multi_map_nav</name>
  <version>0.0.0</version>
  <description>Multi-map navigation using wormholes.</description>
  <maintainer email="keerthi003keerthi@gmail.com">keerthi</maintainer>
  <license>TODO: License declaration</license>

  <!-- Build tool -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Build dependencies -->
  <build_depend>rosidl_default_generators</build_depend>
  <build_depend>nav2_common</build_depend>
  <build_depend>nav2_msgs</build_depend>
  <build_depend>nav2_map_server</build_depend>
  <build_depend>std_srvs</build_depend>

  <!-- Exec dependencies -->
  <exec_depend>rosidl_default_runtime</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>rclcpp_action</exec_depend>

  <!-- For action/service generation -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

